msgstr "Accesos directos"

msgid "Show project count"
msgstr "Mostrar número de proyectos"

msgid "Show project names"
msgstr "Mostrar nombres de proyectos"

msgid "Some services need attention"
msgstr "Algunos servicios requieren atención"

msgid "TCP port"
msgstr "Puerto TCP"

msgid "Top bar label (optional)"
msgstr "Etiqueta de la barra superior (opcional)"

msgid "Unknown"
msgstr "Desconocido"

msgid "Use + to add your first server and its services."
msgstr "Usa + para añadir tu primer servidor y sus servicios."

msgid "Use a read-only health endpoint. Redirects are treated as failures."
msgstr "Usa un punto de estado de solo lectura. Las redirecciones se consideran fallos."

msgid "Uses your desktop theme, fonts and language automatically."
msgstr "Usa automáticamente el tema, las fuentes y el idioma del escritorio."

msgid "Waiting for confirmed status"
msgstr "Esperando la confirmación del estado"

msgid "Waiting for first check"
msgstr "Esperando la primera comprobación"

