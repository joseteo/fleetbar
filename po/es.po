msgstr "Nombre de la comprobación"

msgid "Project"
msgstr "Proyecto"

msgid "Project configuration could not be read"
msgstr "No se pudo leer la configuración de proyectos"

msgid "Project folder"
msgstr "Carpeta del proyecto"

msgid "Projects"
msgstr "Proyectos"

msgid "Provider or group"
msgstr "Proveedor o grupo"

msgid "Reachable"
msgstr "Accesible"

msgid "Reads a local service monitor. Results older than two minutes become unknown."
msgstr "Lee los resultados del monitor local. Pasados dos minutos sin actualizar, el estado pasa a desconocido."

msgid "Recovered"
msgstr "Recuperado"

msgid "Refresh now"
msgstr "Actualizar ahora"

msgid "Remove"
msgstr "Eliminar"

msgid "Remove project"
msgstr "Eliminar proyecto"

msgid "Remove project?"
msgstr "¿Eliminar el proyecto?"

msgid "Remove service"
msgstr "Eliminar servicio"

msgid "Repair the configuration file before adding projects."
msgstr "Repara el archivo de configuración antes de añadir proyectos."

msgid "Response field (optional)"
msgstr "Campo de la respuesta (opcional)"

msgid "Retrying to confirm"
msgstr "Reintentando para confirmar"

msgid "SSH connection"
msgstr "Conexión SSH"

msgid "Save"
msgstr "Guardar"

msgid "Save changes"
msgstr "Guardar cambios"

msgid "Select"
msgstr "Seleccionar"

