msgid "A hostname or label to identify this server"
msgstr "Un nombre de equipo o una etiqueta para identificar el servidor"

msgid "A service is marked offline after two failed checks. Old observations are shown as unknown."
msgstr "Un servicio pasa a sin conexión tras dos fallos seguidos. Los resultados antiguos se muestran como desconocidos."

msgid "A short name such as API or Web. Leave empty to use the project name."
msgstr "Un nombre corto como API o Web. Déjalo vacío para usar el nombre del proyecto."

msgid "Add a project in Settings to get started"
msgstr "Añade un proyecto en Ajustes para empezar"

msgid "Add at least one service"
msgstr "Añade al menos un servicio"

msgid "Add project"
msgstr "Añadir proyecto"

msgid "Add separate checks for the instance, API and its dependencies."
msgstr "Añade comprobaciones independientes para la instancia, la API y sus dependencias."

msgid "Add service"
msgstr "Añadir servicio"

msgid "All systems operational"
msgstr "Todos los sistemas operativos"

msgid "Cancel"
msgstr "Cancelar"

msgid "Cannot connect"
msgstr "No se puede conectar"

msgid "Check every (seconds)"
msgstr "Comprobar cada (segundos)"

msgid "Check is out of date"
msgstr "Comprobación desactualizada"

msgid "Check type"
msgstr "Tipo de comprobación"

msgid "Checking…"
msgstr "Comprobando…"

msgid "Checks connectivity only. An open port does not prove the application is healthy."
msgstr "Solo comprueba la conectividad. Un puerto abierto no garantiza que la aplicación funcione."

msgid "Checks unavailable"
msgstr "Comprobaciones no disponibles"

msgid "Choose SSH key"
msgstr "Elegir clave SSH"

msgid "Choose project folder"
msgstr "Elegir carpeta del proyecto"

msgid "Configuration needs attention"
msgstr "La configuración requiere atención"

msgid "Confirmed outages and recoveries, grouped per check"
msgstr "Caídas y recuperaciones confirmadas, agrupadas por comprobación"

msgid "Connect with SSH"
msgstr "Conectar por SSH"

msgid "Connection timed out"
msgstr "Tiempo de conexión agotado"

msgid "Connection timeout (seconds)"
msgstr "Tiempo de espera (segundos)"

msgid "Could not open the terminal"
msgstr "No se pudo abrir el terminal"

msgid "Could not open this location"
msgstr "No se pudo abrir esta ubicación"

msgid "Could not save projects. Check the connection details and file permissions."
msgstr "No se pudieron guardar los proyectos. Revisa los datos de conexión y los permisos del archivo."

msgid "Display each project name beside its status dot"
msgstr "Mostrar el nombre de cada proyecto junto a su indicador de estado"

msgid "Edit project"
msgstr "Editar proyecto"

msgid "Edit service"
msgstr "Editar servicio"

msgid "Enter a name, group and at least one valid service. Check optional URLs and paths."
msgstr "Introduce un nombre, un grupo y al menos un servicio válido. Revisa las URL y rutas opcionales."

msgid "Enter a service name and valid connection details"
msgstr "Introduce un nombre de servicio y datos de conexión válidos"

msgid "Fleetbar"
msgstr "Fleetbar"

msgid "For a nested field, use a dot: components.database.status"
msgstr "Para campos anidados, usa un punto: components.database.status"

msgid "For example: Hetzner, netcup, Local / Tailscale"
msgstr "Por ejemplo: Hetzner, netcup, Local / Tailscale"

msgid "For example: deploy@example.com"
msgstr "Por ejemplo: deploy@example.com"

msgid "For example: ok, healthy, true"
msgstr "Por ejemplo: ok, healthy, true"

msgid "Grouped by provider in the top bar. Checks never restart or modify your servers."
msgstr "Agrupados por proveedor en la barra superior. Las comprobaciones no reinician ni modifican los servidores."

msgid "HTTP health check"
msgstr "Estado por HTTP"

msgid "Health URL"
msgstr "URL de estado"

msgid "Health check failed"
msgstr "El servicio no está saludable"

msgid "Health checks"
msgstr "Comprobaciones de estado"

msgid "Healthy value"
msgstr "Valor saludable"

msgid "Host"
msgstr "Servidor"

msgid "Host or SSH alias"
msgstr "Servidor o alias SSH"

