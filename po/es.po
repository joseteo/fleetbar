msgstr "Monitor no disponible"

msgid "Monitoring"
msgstr "Supervisión"

msgid "Name"
msgstr "Nombre"

msgid "Needs attention"
msgstr "Requiere atención"

msgid "No projects yet"
msgstr "Todavía no hay proyectos"

msgid "Not checked yet"
msgstr "Sin comprobar"

msgid "Notify on status changes"
msgstr "Notificar los cambios de estado"

msgid "Offline"
msgstr "Sin conexión"

msgid "Online"
msgstr "En línea"

